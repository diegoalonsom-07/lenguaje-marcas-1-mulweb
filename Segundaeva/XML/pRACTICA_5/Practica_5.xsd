<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="aeropuerto" type="tipoAeropuerto"/>

    <xs:complexType name="tipoAeropuerto">
        <xs:sequence>
            <xs:element name="avion" type="tipoAvion" maxOccurs="25"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="tipoAvion">
        <xs:sequence>
            <xs:element name="modelo" type="tipoModelo" />
            <xs:element name="compañia" type="tipoCompañia"/>
            <xs:element name="numvuelo" type="tipoNumVuelo"/>
            <xs:element name="prioridad" type="tipoPrioridad" default="3" minOccurs="0"/>
            <xs:element name="localizacion" type="tipoLocalizacion"/>
            <xs:element name="combustible" type="tipoCombustible"/>
        </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="tipoModelo">
        <xs:restriction base="xs:string">
            <xs:length value="5"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="tipoCompañia">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Ryanair"/>
            <xs:enumeration value="Iberia"/>
            <xs:enumeration value="Emirates"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="tipoNumVuelo">
        <xs:restriction base="xs:int">
            <xs:pattern value="[0-9]{4}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="tipoPrioridad">
        <xs:restriction base="xs:int">
            <xs:minInclusive value="1"/>
            <xs:maxInclusive value="3"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="tipoLocalizacion">
        <xs:all>
            <xs:element name="puerta" type="tipoPuerta"/>
            <xs:element name="letra" type="xs:string"/>
        </xs:all>
    </xs:complexType>

    <xs:simpleType name="tipoPuerta">
        <xs:restriction base="xs:int">
            <xs:minInclusive value="1"/>
            <xs:maxInclusive value="10"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="tipoCombustible">
        <xs:sequence>
            <xs:element name="litros" type="tipoLitros"/>
            <xs:element name="temperatura" type="xs:decimal"/>
        </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="tipoLitros">
        <xs:restriction base="xs:decimal">
            <xs:minInclusive value="0"/>
            <xs:maxInclusive value="2000"/>
        </xs:restriction>
    </xs:simpleType>
</xs:schema>